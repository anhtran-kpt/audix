// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// USER MANAGEMENT & AUTHENTICATION
// ================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  image        String?
  passwordHash String?
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  playlists               Playlist[]
  likedAlbums             UserLikedAlbum[]
  likedPlaylists          UserLikedPlaylist[]
  followedArtists         UserFollowedArtist[]
  playHistory             PlayHistory[]
  searchHistory           SearchHistory[]
  playbackSession         PlaybackSession[]
  playbackContextSnapshot PlaybackContextSnapshot[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String @id @default(uuid())
  userId            String @map("user_id")
  provider          String
  providerAccountId String @map("provider_account_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ================================
// MUSIC CORE ENTITIES
// ================================

model Artist {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  bio      String? @db.Text
  avatarId String?
  bannerId String?

  avatarColor String?
  bannerColor String?

  followersCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  albums     Album[]
  songs      SongArtist[]
  genres     ArtistGenre[]
  followedBy UserFollowedArtist[]
  credits    SongCredit[]

  @@index([slug])
  @@map("artists")
}

model Album {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  thumbnailId String?
  type        AlbumType @default(SINGLE)
  releaseDate DateTime  @default(now())
  totalSongs  Int       @default(0)
  duration    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artistId String
  artist   Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs    Song[]
  genres   AlbumGenre[]
  likedBy  UserLikedAlbum[]

  @@index([slug])
  @@map("albums")
}

enum AlbumType {
  SINGLE
  EP
  ALBUM
}

model Song {
  id         String   @id @default(uuid())
  title      String
  audioId    String
  duration   Int
  songNumber Int
  lyrics     String?  @db.Text
  isExplicit Boolean  @default(false)
  playCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  artists              SongArtist[]
  credits              SongCredit[]
  genres               SongGenre[]
  playlistItems        PlaylistSong[]
  playHistory          PlayHistory[]
  playbackSnapshotSong PlaybackSnapshotSong[]
  playbackQueueItem    PlaybackQueueItem[]
  playbackSessions     PlaybackSession[]

  @@map("songs")
}

// ================================
// GENRE SYSTEM
// ================================

model Genre {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  songs   SongGenre[]
  albums  AlbumGenre[]
  artists ArtistGenre[]

  @@index([slug])
  @@map("genres")
}

// ================================
// SONG-ARTIST RELATIONSHIP & CREDITS SYSTEM
// ================================

model SongArtist {
  id       String     @id @default(uuid())
  songId   String
  artistId String
  role     ArtistRole @default(MAIN_ARTIST)
  order    Int        @default(0) // Artist order (main artist first)

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([songId, artistId, role])
  @@index([songId, order])
  @@map("song_artists")
}

enum ArtistRole {
  MAIN_ARTIST
  FEATURED_ARTIST
  REMIX_ARTIST
}

model SongCredit {
  id       String     @id @default(uuid())
  songId   String
  artistId String? // Null if it set for the person who is not artist
  name     String // Credit name (if artistId null)
  role     CreditRole
  details  String?
  order    Int        @default(0)

  song   Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([songId, role])
  @@index([songId, order])
  @@index([songId, artistId])
  @@map("song_credits")
}

enum CreditRole {
  // Performers
  LEAD_VOCALS
  BACKING_VOCALS
  RAP

  // Songwriters & Composers
  SONGWRITER
  COMPOSER
  LYRICIST

  // Producers & Engineers
  PRODUCER
  EXECUTIVE_PRODUCER
  CO_PRODUCER
  VOCAL_PRODUCER
  MIXING_ENGINEER
  MASTERING_ENGINEER
  RECORDING_ENGINEER
  ASSISTANT_ENGINEER

  // Musicians
  GUITAR
  BASS
  DRUMS
  PIANO
  KEYBOARD
  VIOLIN
  SAXOPHONE
  TRUMPET
  OTHER_INSTRUMENT

  // Other Roles
  ARRANGER
  PROGRAMMER
  ADDITIONAL_PRODUCTION

  // Legal & Business
  PUBLISHER
  RECORD_LABEL
  MANAGEMENT
}

model SongGenre {
  songId  String
  genreId String

  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([songId, genreId])
  @@map("song_genres")
}

model AlbumGenre {
  albumId String
  genreId String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@map("album_genres")
}

model ArtistGenre {
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@map("artist_genres")
}

// ================================
// PLAYLIST SYSTEM
// ================================

model Playlist {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  imageId     String?
  isPublic    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  systemType  String?
  totalSongs  Int      @default(0)
  duration    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  userId  String?
  user    User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs   PlaylistSong[]
  likedBy UserLikedPlaylist[]

  @@index([slug])
  @@map("playlists")
}

model PlaylistSong {
  id       String   @id @default(uuid())
  position Int // Position in playlist
  addedAt  DateTime @default(now())

  playlistId String
  songId     String

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@map("playlist_items")
}

// ================================
// USER INTERACTIONS (LIKES/FOLLOWS)
// ================================

model UserLikedAlbum {
  userId  String
  albumId String
  likedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@map("user_liked_albums")
}

model UserFollowedArtist {
  userId     String
  artistId   String
  followedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("user_followed_artists")
}

model UserLikedPlaylist {
  userId     String
  playlistId String
  likedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([userId, playlistId])
  @@map("user_liked_playlists")
}

// ================================
// LISTENING BEHAVIOR & ANALYTICS
// ================================

enum RepeatMode {
  OFF
  ONE
  ALL
}

enum QueueItemKind {
  NEXT // "Play next" 
  LATER // "Add to queue" 
}

enum PlaybackContextType {
  PLAYLIST
  ALBUM
  ARTIST
  SONG
  HISTORY
  SEARCH
}

model PlaybackSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Playback state
  snapshotId    String
  snapshot      PlaybackContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  contextIndex  Int                     @default(0)
  currentSongId String
  currentSong   Song                    @relation(fields: [currentSongId], references: [id], onDelete: Cascade)

  isShuffled Boolean    @default(false)
  repeatMode RepeatMode @default(OFF)

  queue PlaybackQueueItem[]

  activeDeviceId String?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("playback_sessions")
}

model PlaybackContextSnapshot {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contextType PlaybackContextType
  contextId   String
  name        String
  hash        String
  createdAt   DateTime            @default(now())

  songs            PlaybackSnapshotSong[]
  playbackSessions PlaybackSession[]
  playHistory      PlayHistory[]

  @@unique([userId, hash])
  @@index([userId, createdAt])
  @@map("playback_snapshots")
}

model PlaybackSnapshotSong {
  snapshotId String
  index      Int
  songId     String

  snapshot PlaybackContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  song     Song                    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([snapshotId, index])
  @@index([snapshotId, songId])
  @@map("playback_snapshot_songs")
}

model PlayHistory {
  id          String   @id @default(uuid())
  playedAt    DateTime @default(now())
  listenedSec Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  snapshotId String
  snapshot   PlaybackContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([songId, playedAt])
  @@map("play_history")
}

model PlaybackQueueItem {
  id        String          @id @default(uuid())
  sessionId String
  session   PlaybackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind     QueueItemKind
  position Int
  songId   String
  song     Song          @relation(fields: [songId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@index([sessionId, kind, position])
  @@map("playback_queue_items")
}

model SearchHistory {
  id         String   @id @default(uuid())
  query      String
  resultType String? // song, artist, album, playlist
  resultId   String?
  searchedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@map("search_history")
}

// ================================
// RECOMMENDATION SYSTEM
// ================================

model UserRecommendation {
  id        String   @id @default(uuid())
  type      String // song, artist, album, playlist
  targetId  String // ID of recommended item
  score     Float //  Recommendation score (0-1)
  reason    String? // The reason to recommend
  createdAt DateTime @default(now())

  userId String

  @@index([userId, type, score])
  @@map("user_recommendations")
}

// ================================
// SYSTEM FEATURES
// ================================

// Trending/Charts
model Chart {
  id        String    @id @default(uuid())
  name      String
  type      ChartType
  period    String // daily, weekly, monthly
  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())

  items ChartItem[]

  @@map("charts")
}

enum ChartType {
  TOP_SONGS
  TOP_ALBUMS
  TOP_ARTISTS
  TRENDING
}

model ChartItem {
  chartId  String
  position Int
  itemType String // song, album, artist
  itemId   String
  plays    Int    @default(0)

  chart Chart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@id([chartId, position])
  @@map("chart_items")
}
